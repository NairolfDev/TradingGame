rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Leaderboard: Live-Rangliste für alle Spieler (Echtzeit-Updates)
    match /leaderboard/{docId} {
      allow read, write: if true;
    }

    // 2. Benutzerprofile
    match /users/{userId} {
      allow read, write: if true;
    }

    // 3. Portfolios & Unterkollektionen für alle Online-Spieler
    match /portfolios/{userId} {
      allow read, write: if true;

      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}
