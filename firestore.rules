rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Version gate: while config/app exists, a player may only write when the
    // build stamped in sessions/{uid} is at least config/app.minBuild.
    // Reads stay open so an outdated app can still show the update prompt.
    function minBuild() {
      return get(/databases/$(database)/documents/config/app).data.minBuild;
    }
    function currentBuild() {
      return !exists(/databases/$(database)/documents/config/app)
        || (exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
            && get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.build >= minBuild());
    }
    function writer(uid) {
      return owner(uid) && currentBuild();
    }

    // 0. Versionsvorgabe (nur lesbar; wird von Hand/Skript gesetzt)
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 0b. Build-Stempel der laufenden App
    match /sessions/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['build'])
        && request.resource.data.build is int
        && (!exists(/databases/$(database)/documents/config/app)
            || request.resource.data.build >= minBuild());
    }
    match /profiles/{uid} {
      allow read: if owner(uid);
      allow create, update: if writer(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'countryCode'])
        && request.resource.data.keys().hasAll(['displayName', 'countryCode'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 48
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode in ['AF', 'AL', 'DZ', 'AS', 'VI', 'UM', 'AD', 'AO', 'AI', 'AQ', 'AG', 'AR', 'AM', 'AW', 'AZ', 'AU', 'BS', 'BH', 'BD', 'BB', 'BY', 'BE', 'BZ', 'BJ', 'BM', 'BT', 'BO', 'BA', 'BW', 'BV', 'BR', 'VG', 'IO', 'BN', 'BG', 'BF', 'BI', 'CV', 'CL', 'CN', 'CK', 'CR', 'CW', 'CI', 'DE', 'DM', 'DO', 'DJ', 'DK', 'EC', 'SV', 'ER', 'EE', 'SZ', 'FK', 'FJ', 'FI', 'FR', 'GF', 'PF', 'TF', 'FO', 'GA', 'GM', 'GE', 'GH', 'GI', 'GD', 'GR', 'GL', 'GP', 'GU', 'GT', 'GG', 'GN', 'GW', 'GY', 'HT', 'HM', 'HN', 'IN', 'ID', 'IQ', 'IR', 'IE', 'IS', 'IM', 'IL', 'IT', 'JM', 'JP', 'YE', 'JE', 'JO', 'KY', 'KH', 'CM', 'CA', 'BQ', 'KZ', 'QA', 'KE', 'KG', 'KI', 'CC', 'CO', 'KM', 'CG', 'CD', 'HR', 'CU', 'KW', 'LA', 'LS', 'LV', 'LB', 'LR', 'LY', 'LI', 'LT', 'LU', 'MG', 'MW', 'MY', 'MV', 'ML', 'MT', 'MA', 'MH', 'MQ', 'MR', 'MU', 'YT', 'MX', 'FM', 'MC', 'MN', 'ME', 'MS', 'MZ', 'MM', 'NA', 'NR', 'NP', 'NC', 'NZ', 'NI', 'NL', 'NE', 'NG', 'NU', 'KP', 'MK', 'NF', 'NO', 'MP', 'OM', 'PK', 'PW', 'PS', 'PA', 'PG', 'PY', 'PE', 'PH', 'PN', 'PL', 'PT', 'PR', 'MD', 'RW', 'RO', 'RU', 'RE', 'SB', 'ZM', 'WS', 'SM', 'SA', 'SE', 'CH', 'SN', 'RS', 'SC', 'SL', 'ZW', 'SG', 'SX', 'SK', 'SI', 'SO', 'HK', 'MO', 'ES', 'SJ', 'LK', 'BL', 'SH', 'KN', 'LC', 'MF', 'PM', 'VC', 'SD', 'SR', 'SY', 'ST', 'ZA', 'GS', 'KR', 'SS', 'TJ', 'TW', 'TZ', 'TH', 'TL', 'TG', 'TK', 'TO', 'TT', 'TD', 'CZ', 'TN', 'TM', 'TC', 'TV', 'TR', 'UG', 'UA', 'HU', 'UY', 'UZ', 'VU', 'VA', 'VE', 'AE', 'US', 'GB', 'VN', 'WF', 'CX', 'EH', 'CF', 'CY', 'EG', 'GQ', 'ET', 'AX', 'AT'];
      allow delete: if owner(uid);
    }
    // 1. Leaderboard: Live-Rangliste für alle Spieler (Echtzeit-Updates)
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if writer(docId);
    }

    // 1b. Öffentliche Portfolios (Copy-Trading): jeder liest, nur der Besitzer schreibt
    match /publicPortfolios/{docId} {
      allow read: if true;
      allow delete: if owner(docId);
      allow create, update: if writer(docId)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'avatarEmoji',
             'netWorth', 'roiPercent', 'winRatePercent', 'riskStyle', 'allocation', 'updatedAt'])
        && request.resource.data.uid == docId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 48
        && request.resource.data.allocation is map
        && request.resource.data.allocation.size() <= 8;
    }

    // 2. Benutzerprofile
    match /users/{userId} {
      allow read: if owner(userId);
      allow write: if writer(userId);
    }

    // 2b. Kursalarme: nur der Besitzer; die App wertet sie selbst aus.
    match /priceAlerts/{alertId} {
      function validAlert() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'assetId', 'symbol', 'name', 'yahooSymbol',
                                 'direction', 'price', 'recurring', 'active', 'armed',
                                 'createdAt', 'lastTriggeredAt'])
          && d.keys().hasAll(['uid', 'symbol', 'yahooSymbol', 'direction', 'price',
                              'recurring', 'active'])
          && d.uid == request.auth.uid
          && d.symbol is string && d.symbol.size() <= 40
          && d.yahooSymbol is string && d.yahooSymbol.size() <= 32
          && d.direction in ['above', 'below']
          && d.price is number && d.price > 0 && d.price < 1000000000
          && d.recurring is bool && d.active is bool;
      }
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && currentBuild() && validAlert();
      allow update: if request.auth != null && currentBuild() && resource.data.uid == request.auth.uid && validAlert();
    }

    // 2c. Push-Token der Geräte (Dokument-ID = FCM-Token)
    match /deviceTokens/{token} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null && currentBuild()
        && request.resource.data.keys().hasOnly(['uid', 'platform', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.platform is string;
    }

    // 3. Portfolios & Unterkollektionen für alle Online-Spieler
    match /portfolios/{userId} {
      allow read: if owner(userId);
      allow write: if writer(userId);

      match /{document=**} {
        allow read: if owner(userId);
        allow write: if writer(userId);
      }
    }
  }
}
